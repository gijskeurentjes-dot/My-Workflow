# ── Server ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Where the SQLite file lives. Relative paths resolve from packages/server.
DATABASE_URL=file:./data/ai-islands.sqlite

# Which agent engine backs the world.
#   mock   — deterministic local simulation (the only engine implemented today)
#   claude — reserved for the real Claude-backed engine; not yet available
AGENT_ENGINE=mock

# How often the agent engine advances the world, in milliseconds.
AGENT_TICK_MS=500

# Browser origin allowed to call the API and open the SSE stream.
CORS_ORIGIN=http://localhost:5173

# ── Reserved for the real agent engine (M10+). Leave unset for now. ───
# Never commit a real key: copy this file to .env and fill it in there.
# ANTHROPIC_API_KEY=
