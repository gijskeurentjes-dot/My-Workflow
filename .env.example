# ── Server ────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Where the SQLite file lives. Relative paths resolve from packages/server.
DATABASE_URL=file:./data/ai-islands.sqlite

# Which agent engine backs the world.
#   mock   — deterministic local simulation (the only engine implemented today)
#   claude — reserved for the real Claude-backed engine; not yet available
AGENT_ENGINE=mock

# How often the agent engine advances the world, in milliseconds.
AGENT_TICK_MS=500

# Whether idle agents take waiting work off the board by themselves.
# On keeps the world moving without anyone clicking; off means you drive
# every task by hand.
MOCK_AUTO_ASSIGN=true

# Browser origin allowed to call the API and open the SSE stream.
CORS_ORIGIN=http://localhost:5173

# ── Real agents ───────────────────────────────────────────────────────
# Nova the Researcher runs on a real Claude model. Leave this unset and the
# app runs exactly as before on the mock engine; set it and `npm run
# agent:nova` works. Never commit a real key: copy this file to .env and fill
# it in there. Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# The model a newly hired agent runs on. Each agent stores its own, so this is
# only the default for new ones.
AGENT_MODEL=claude-opus-5

# How many web searches one research run may perform.
AGENT_MAX_SEARCHES=8
